@using Microsoft.AspNetCore.Identity
@using Syphonic.Data
@inject SignInManager<ApplicationUser> SignInManager
@{
    // Work out which section we are in so the matching nav link can be highlighted.
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    var currentArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;

    bool IsSection(string prefix) =>
        currentArea.Length == 0 &&
        (prefix == "/Index"
            ? currentPage == "/Index"
            : currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));

    string ActiveClass(string prefix) => IsSection(prefix) ? "active" : string.Empty;
    string? AriaCurrent(string prefix) => IsSection(prefix) ? "page" : null;

    var signedIn = SignInManager.IsSignedIn(User);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Syphonic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<a class="visually-hidden-focusable btn btn-light position-absolute m-2" href="#main" style="z-index: 1100">Skip to content</a>
<header class="sticky-top">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sy-navbar" aria-label="Main">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">🌍 Syphonic</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("/Index")" aria-current="@AriaCurrent("/Index")" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("/Lessons")" aria-current="@AriaCurrent("/Lessons")" asp-area="" asp-page="/Lessons/Index">Lessons</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("/Practice")" aria-current="@AriaCurrent("/Practice")" asp-area="" asp-page="/Practice/Index">Practice</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("/Maps")" aria-current="@AriaCurrent("/Maps")" asp-area="" asp-page="/Maps/Index">Maps</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("/Leaderboard")" aria-current="@AriaCurrent("/Leaderboard")" asp-area="" asp-page="/Leaderboard/Index">Leaderboard</a>
                    </li>
                    @if (signedIn)
                    {
                        <li class="nav-item">
                            <a class="nav-link @ActiveClass("/Dashboard")" aria-current="@AriaCurrent("/Dashboard")" asp-area="" asp-page="/Dashboard/Index">Dashboard</a>
                        </li>
                    }
                </ul>
                <form class="sy-nav-search d-flex my-2 my-lg-0 me-lg-3" role="search" method="get" asp-area="" asp-page="/Lessons/Index">
                    <input class="form-control form-control-sm" type="search" name="q" placeholder="Search lessons" aria-label="Search lessons" />
                </form>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>
<main id="main" class="container pt-4 pb-5">
    @RenderBody()
</main>
<footer class="border-top footer text-muted py-3 mt-auto">
    <div class="container small d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <span>&copy; @DateTime.UtcNow.Year Syphonic · Geography practice for everyone</span>
        <nav aria-label="Footer">
            <a class="link-secondary text-decoration-none" asp-area="" asp-page="/Learn/Index">How we teach</a>
            <span class="text-muted mx-2" aria-hidden="true">·</span>
            <a class="link-secondary text-decoration-none" asp-area="" asp-page="/Privacy">Privacy</a>
            <span class="text-muted mx-2" aria-hidden="true">·</span>
            <a class="link-secondary text-decoration-none" href="/api/lessons/published">Lessons API</a>
        </nav>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@*
    "Home / Lessons / Climate zones" trail at the top of a page, so learners always see where they are
    and can step back up with one click. Home is added automatically; pass the steps after it.
    The last step is the current page and is not a link.
*@
@model IReadOnlyList<Syphonic.Helpers.Crumb>
<nav aria-label="You are here" class="sy-crumbs">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-area="" asp-page="/Index">Home</a></li>
        @for (var i = 0; i < Model.Count; i++)
        {
            var step = Model[i];
            var isCurrent = i == Model.Count - 1 || step.Url is null;
            @if (isCurrent)
            {
                <li class="breadcrumb-item active" aria-current="page">@step.Label</li>
            }
            else
            {
                <li class="breadcrumb-item"><a href="@step.Url">@step.Label</a></li>
            }
        }
    </ol>
</nav>

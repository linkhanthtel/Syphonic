@*
    "Where to next?" panel for the end of a lesson, quiz, flashcard deck or practice round, so the
    learner never reaches a dead end. The optional model is one extra link for the page's own context,
    such as "Back to the lesson", shown first.
*@
@model Syphonic.Helpers.Crumb?
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<section class="sy-where-next card border-0 bg-body-tertiary mt-4" aria-labelledby="where-next-heading">
    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
        <h2 id="where-next-heading" class="h6 mb-0 flex-shrink-0">Where to next?</h2>
        <div class="d-flex flex-wrap gap-2">
            @if (Model?.Url is { } contextUrl)
            {
                <a class="btn btn-sm btn-outline-primary" href="@contextUrl">@Model.Label</a>
            }
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-page="/Lessons/Index">All lessons</a>
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-page="/Practice/Index">Practice</a>
            @if (signedIn)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-page="/Dashboard/Index">My dashboard</a>
            }
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-page="/Index">Home</a>
        </div>
        @if (!signedIn)
        {
            <p class="small text-muted mb-0 ms-md-auto">
                <a asp-area="Identity" asp-page="/Account/Register">Create a free account</a> to get a dashboard of your progress.
            </p>
        }
    </div>
</section>

@page
@model ReviewModel
@using Syphonic.Services
@{
    ViewData["Title"] = "Review";
    var result = Model.Result;
    var summary = Model.Summary;
}

<partial name="_Breadcrumbs" model="@(new Crumb[] { new("Practice", Url.Page("/Practice/Index")), new("Review") })" />

<h1 class="mb-1">Review</h1>
<p class="text-muted mb-3">
    Questions you have answered come back here just before you would forget them. Missed ones return straight away; ones you know wait longer each time.
</p>

<partial name="_PracticeModes" model='"review"' />

@* ---------- Where the learner's questions stand ---------- *@
@if (summary.Total > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="sy-stat-label">Due now</div>
                    <div class="sy-stat-value">@summary.Due</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="sy-stat-label">Still learning</div>
                    <div class="sy-stat-value">@summary.Learning</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="sy-stat-label">Familiar</div>
                    <div class="sy-stat-value">@summary.Familiar</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="sy-stat-label">Mastered</div>
                    <div class="sy-stat-value">@summary.Mastered</div>
                </div>
            </div>
        </div>
    </div>
}

@if (result is not null)
{
    @* ---------- Results view (after submitting) ---------- *@
    <div class="alert @(result.Score == result.Total ? "alert-success" : "alert-warning")">
        <div class="fs-4 fw-semibold">You got @result.Score of @result.Total right</div>
        <div>
            @if (summary.Due > 0)
            {
                <span>@summary.Due question@(summary.Due == 1 ? " is" : "s are") ready for another try.</span>
            }
            else if (summary.NextDueInDays is int days)
            {
                <span>Nothing else is due. Your next review is @ReviewService.DescribeDays(days).</span>
            }
        </div>
    </div>

    <ol class="list-unstyled d-grid gap-3 mb-4">
        @foreach (var item in result.Items)
        {
            var correctLetter = QuizQuestion.LetterFor(item.Question.CorrectOption);
            <li class="card shadow-sm border-start border-4 @(item.IsCorrect ? "border-success" : "border-danger")">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2">
                        <h2 class="h6 mb-3">@item.Question.Prompt</h2>
                        <span class="badge align-self-start @(item.IsCorrect ? "text-bg-success" : "text-bg-danger")">
                            @(item.IsCorrect ? "Correct" : "Incorrect")
                        </span>
                    </div>
                    <ul class="list-unstyled mb-2">
                        @foreach (var option in item.Question.GetOptions())
                        {
                            var isRight = option.Index == item.Question.CorrectOption;
                            var isChosen = option.Index == item.ChosenOption;
                            <li class="quiz-option py-1 px-2 rounded @(isRight ? "quiz-option-correct" : isChosen ? "quiz-option-wrong" : null)">
                                <strong>@option.Letter.</strong> @option.Text
                                @if (isChosen) { <span class="small text-muted">(your answer)</span> }
                            </li>
                        }
                    </ul>
                    @if (!item.IsCorrect)
                    {
                        <div class="small">Correct answer: <strong>@correctLetter</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Question.Explanation))
                    {
                        <div class="small text-muted mt-1">@item.Question.Explanation</div>
                    }
                    <div class="small mt-2">
                        From <a asp-page="/Lessons/Detail" asp-route-slug="@item.Question.Lesson.Slug">@item.Question.Lesson.Title</a>
                        @if (Model.Outcomes.TryGetValue(item.Question.Id, out var outcome))
                        {
                            <span class="text-muted">· Comes back @(outcome.DueInDays == 0 ? "in your next review" : ReviewService.DescribeDays(outcome.DueInDays))</span>
                        }
                    </div>
                </div>
            </li>
        }
    </ol>

    <div class="d-flex flex-wrap gap-2">
        @if (summary.Due > 0)
        {
            <a class="btn btn-primary" asp-page="Review">Review @summary.Due more</a>
        }
        <a class="btn @(summary.Due > 0 ? "btn-outline-secondary" : "btn-primary")" asp-page="Index">Mixed practice round</a>
    </div>

    <partial name="_WhereNext" model="null" />
}
else if (Model.Questions.Count == 0)
{
    @* ---------- Nothing to review ---------- *@
    <div class="card shadow-sm">
        <div class="card-body">
            @if (summary.Total == 0)
            {
                <h2 class="h5">Your review list is empty</h2>
                <p class="text-muted">Take a lesson quiz or a mixed round first. Every question you answer is added here and scheduled for you.</p>
            }
            else
            {
                <h2 class="h5">You are up to date</h2>
                <p class="text-muted">
                    Nothing is due right now.
                    @if (summary.NextDueInDays is int days)
                    {
                        <span>Your next review is @ReviewService.DescribeDays(days).</span>
                    }
                </p>
            }
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-page="Index">Mixed practice round</a>
                <a class="btn btn-outline-secondary" asp-page="/Lessons/Index">Browse lessons</a>
            </div>
        </div>
    </div>
}
else
{
    @* ---------- Question form (before submitting) ---------- *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form method="post">
        @foreach (var question in Model.Questions)
        {
            <input type="hidden" name="QuestionIds" value="@question.Id" />
        }
        <ol class="list-unstyled d-grid gap-3 mb-4">
            @{ var number = 0; }
            @foreach (var question in Model.Questions)
            {
                number++;
                <li class="card shadow-sm">
                    <fieldset class="card-body">
                        <legend class="h6 mb-3">@number. @question.Prompt</legend>
                        @foreach (var option in question.GetOptions())
                        {
                            var inputId = $"q{question.Id}_{option.Index}";
                            var isChecked = Model.Answers.TryGetValue(question.Id, out var picked) && picked == option.Index;
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="@inputId"
                                       name="Answers[@question.Id]" value="@option.Index" checked="@isChecked" />
                                <label class="form-check-label" for="@inputId">@option.Letter. @option.Text</label>
                            </div>
                        }
                    </fieldset>
                </li>
            }
        </ol>
        <button type="submit" class="btn btn-primary btn-lg">Check my answers</button>
    </form>
}

@page
@model DrillsModel
@{
    ViewData["Title"] = "Country drills";
    var results = Model.Results;
}

<h1 class="mb-1">Country drills</h1>
<p class="text-muted mb-3">
    Ten quick questions on capitals, continents or population, drawn from 194 countries. A new set every time.
</p>

<partial name="_PracticeModes" model='"drills"' />

@* ---------- Choose a drill ---------- *@
<form method="get" class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div class="sy-drill-field">
            <label class="form-label small text-muted mb-1" for="topic">Drill</label>
            <select class="form-select" id="topic" name="topic">
                @foreach (var topic in DrillsModel.Topics)
                {
                    <option value="@topic.Key" selected="@(topic.Key == Model.Topic)">@topic.Value</option>
                }
            </select>
        </div>
        <div class="sy-drill-field">
            <label class="form-label small text-muted mb-1" for="region">Part of the world</label>
            <select class="form-select" id="region" name="region" aria-describedby="regionHelp">
                <option value="all">Whole world</option>
                @foreach (var region in Model.Regions)
                {
                    <option value="@region" selected="@(region == Model.Region)">@region</option>
                }
            </select>
        </div>
        <button type="submit" class="btn @(Model.Topic is null ? "btn-primary" : "btn-outline-primary")">
            @(Model.Topic is null ? "Start drill" : "New drill")
        </button>
        <div id="regionHelp" class="form-text w-100 mt-0">The continent drill always uses the whole world.</div>
    </div>
</form>

@if (results is not null)
{
    @* ---------- Results ---------- *@
    var passed = Model.Score * 100 >= results.Count * Syphonic.Services.QuizResult.PassPercent;
    <div class="alert @(passed ? "alert-success" : "alert-warning") d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fs-4 fw-semibold">You scored @Model.Score / @results.Count</div>
            <div>@Model.TopicName · @Model.RegionName</div>
        </div>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="small">
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Practice/Drills")">Log in</a> to keep a record of your drills.
            </div>
        }
    </div>

    <ol class="list-group list-group-numbered shadow-sm mb-4">
        @foreach (var item in results)
        {
            <li class="list-group-item d-flex gap-2">
                <div class="flex-grow-1 ms-1">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="fw-semibold">@item.Prompt</span>
                        <span class="badge align-self-start @(item.IsCorrect ? "text-bg-success" : "text-bg-danger")">@(item.IsCorrect ? "Correct" : "Incorrect")</span>
                    </div>
                    <div class="small">
                        Your answer: @item.YourAnswer
                        @if (!item.IsCorrect || item.Note is not null)
                        {
                            <span>· Answer: <strong>@item.CorrectAnswer</strong></span>
                        }
                    </div>
                    @if (item.Note is not null)
                    {
                        <div class="small text-muted">@item.Note</div>
                    }
                </div>
            </li>
        }
    </ol>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-primary" asp-page="Drills" asp-route-topic="@Model.Topic" asp-route-region="@(Model.Region == "all" ? null : Model.Region)">Same drill, new questions</a>
        <a class="btn btn-outline-secondary" asp-page="/Maps/Index">Look them up on the map</a>
    </div>
}
else if (Model.Topic is not null && Model.Questions.Count == 0)
{
    <div class="alert alert-info">There are not enough countries for that drill. Try the whole world.</div>
}
else if (Model.Topic is not null)
{
    @* ---------- Questions ---------- *@
    <h2 class="h5 mb-3">@Model.TopicName · @Model.RegionName</h2>
    <form method="post" asp-route-topic="@Model.Topic" asp-route-region="@(Model.Region == "all" ? null : Model.Region)" autocomplete="off">
        <ol class="list-unstyled d-grid gap-3 mb-4">
            @for (var i = 0; i < Model.Questions.Count; i++)
            {
                var question = Model.Questions[i];
                <li class="card shadow-sm">
                    <input type="hidden" name="Q[@i].CountryId" value="@question.CountryId" />
                    <input type="hidden" name="Q[@i].OtherId" value="@question.OtherId" />
                    @if (Model.IsTyped)
                    {
                        <div class="card-body">
                            <label class="h6 d-block mb-2" for="q@(i)">@(i + 1). @question.Prompt</label>
                            <input class="form-control sy-drill-typed" type="text" id="q@(i)" name="Q[@i].Answer"
                                   autocomplete="off" autocapitalize="words" spellcheck="false" />
                        </div>
                    }
                    else
                    {
                        <fieldset class="card-body">
                            <legend class="h6 mb-3">@(i + 1). @question.Prompt</legend>
                            <div class="sy-drill-options">
                                @foreach (var option in question.Options)
                                {
                                    var inputId = $"q{i}_{option.Value.Replace(' ', '_')}";
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" id="@inputId" name="Q[@i].Answer" value="@option.Value" />
                                        <label class="form-check-label" for="@inputId">@option.Label</label>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                </li>
            }
        </ol>
        @if (Model.IsTyped)
        {
            <p class="small text-muted">Capital letters and accents do not matter. Leave a box empty if you do not know.</p>
        }
        <button type="submit" class="btn btn-primary btn-lg">Check my answers</button>
    </form>
}

@* ---------- The learner's own history ---------- *@
@if (User.Identity?.IsAuthenticated == true && (Model.Topic is null || results is not null))
{
    <section class="mt-4" aria-labelledby="recent-heading">
        <h2 id="recent-heading" class="h5 mb-3">Your recent drills</h2>
        @if (Model.Recent.Count == 0)
        {
            <div class="sy-empty">No drills yet. Pick one above to start.</div>
        }
        else
        {
            <ul class="list-group shadow-sm">
                @foreach (var drill in Model.Recent)
                {
                    <li class="list-group-item d-flex flex-wrap justify-content-between gap-2">
                        <span>@drill.Description</span>
                        <span class="small text-muted">@drill.When.ToLocalTime().ToString("d MMM, HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </section>
}
else if (Model.Topic is null)
{
    <p class="small text-muted">
        Drills are open to everyone. <a asp-area="Identity" asp-page="/Account/Register">Create a free account</a> to keep a record of your scores.
    </p>
}

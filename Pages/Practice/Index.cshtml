@page
@model IndexModel
@using Syphonic.Services
@{
    ViewData["Title"] = "Practice";
    var result = Model.Result;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="mb-1">Practice round</h1>
        <p class="text-muted mb-0">Random questions mixed from every lesson. A new set is drawn each round.</p>
    </div>
    @if (result is null && Model.Questions.Count > 0)
    {
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted">Questions:</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Number of questions">
                @foreach (var choice in IndexModel.CountChoices)
                {
                    <a class="btn @(Model.Questions.Count == choice ? "btn-primary" : "btn-outline-primary")"
                       asp-page="Index" asp-route-count="@choice">@choice</a>
                }
            </div>
        </div>
    }
</div>

@if (Model.Questions.Count == 0)
{
    <div class="alert alert-info">There are no quiz questions to practise yet.</div>
    <a class="btn btn-outline-secondary" asp-page="/Lessons/Index">Browse lessons</a>
}
else if (result is not null)
{
    @* ---------- Results view (after submitting) ---------- *@
    <div class="alert @(result.Passed ? "alert-success" : "alert-warning") d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fs-4 fw-semibold">You scored @result.Score / @result.Total (@result.Percent%)</div>
            <div>@(result.Passed ? "Great recall!" : "Each miss below links to the lesson worth another look.")</div>
        </div>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="small">
                <a asp-area="Identity" asp-page="/Account/Login">Log in</a> so practice counts towards your streak.
            </div>
        }
    </div>

    <ol class="list-unstyled d-grid gap-3 mb-4">
        @foreach (var item in result.Items)
        {
            var correctLetter = Syphonic.Models.QuizQuestion.LetterFor(item.Question.CorrectOption);
            <li class="card shadow-sm border-start border-4 @(item.IsCorrect ? "border-success" : "border-danger")">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2">
                        <h2 class="h6 mb-3">@item.Question.Prompt</h2>
                        <span class="badge align-self-start @(item.IsCorrect ? "text-bg-success" : "text-bg-danger")">
                            @(item.IsCorrect ? "Correct" : "Incorrect")
                        </span>
                    </div>
                    <ul class="list-unstyled mb-2">
                        @foreach (var option in item.Question.GetOptions())
                        {
                            var isRight = option.Index == item.Question.CorrectOption;
                            var isChosen = option.Index == item.ChosenOption;
                            <li class="quiz-option py-1 px-2 rounded @(isRight ? "quiz-option-correct" : isChosen ? "quiz-option-wrong" : null)">
                                <strong>@option.Letter.</strong> @option.Text
                                @if (isChosen) { <span class="small text-muted">(your answer)</span> }
                            </li>
                        }
                    </ul>
                    @if (!item.IsCorrect)
                    {
                        <div class="small">Correct answer: <strong>@correctLetter</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Question.Explanation))
                    {
                        <div class="small text-muted mt-1">@item.Question.Explanation</div>
                    }
                    <div class="small mt-2">
                        From <a asp-page="/Lessons/Detail" asp-route-slug="@item.Question.Lesson.Slug">@item.Question.Lesson.Title</a>
                    </div>
                </div>
            </li>
        }
    </ol>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-page="Index" asp-route-count="@result.Total">New round</a>
        <a class="btn btn-outline-secondary" asp-page="/Lessons/Index">Back to lessons</a>
    </div>
}
else
{
    @* ---------- Question form (before submitting) ---------- *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form method="post">
        @foreach (var question in Model.Questions)
        {
            <input type="hidden" name="QuestionIds" value="@question.Id" />
        }
        <ol class="list-unstyled d-grid gap-3 mb-4">
            @{ var number = 0; }
            @foreach (var question in Model.Questions)
            {
                number++;
                <li class="card shadow-sm">
                    <fieldset class="card-body">
                        <legend class="h6 mb-3">@number. @question.Prompt</legend>
                        @foreach (var option in question.GetOptions())
                        {
                            var inputId = $"q{question.Id}_{option.Index}";
                            var isChecked = Model.Answers.TryGetValue(question.Id, out var picked) && picked == option.Index;
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="@inputId"
                                       name="Answers[@question.Id]" value="@option.Index" checked="@isChecked" />
                                <label class="form-check-label" for="@inputId">@option.Letter. @option.Text</label>
                            </div>
                        }
                    </fieldset>
                </li>
            }
        </ol>
        <button type="submit" class="btn btn-primary btn-lg">Check my answers</button>
        <a class="btn btn-link" asp-page="Index" asp-route-count="@Model.Questions.Count">Draw different questions</a>
    </form>
}

@page "/Lessons/{slug}"
@model DetailModel
@{
    ViewData["Title"] = Model.Lesson?.Title ?? "Lesson";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (Model.Lesson is null)
{
    <div class="alert alert-warning mb-0">Lesson not found.</div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Lessons</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Lesson.Title</li>
        </ol>
    </nav>

    <article class="mt-3">
        <header class="mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h1 class="mb-2">@Model.Lesson.Title</h1>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page-handler="Bookmark" class="flex-shrink-0">
                        <input type="hidden" name="slug" value="@Model.Lesson.Slug" />
                        <button type="submit" class="btn btn-sm @(Model.IsBookmarked ? "btn-warning" : "btn-outline-secondary")"
                                aria-pressed="@(Model.IsBookmarked ? "true" : "false")">
                            @(Model.IsBookmarked ? "★ Saved" : "☆ Save for later")
                        </button>
                    </form>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Lesson.Summary))
            {
                <p class="lead text-muted mb-1">@Model.Lesson.Summary</p>
            }
            <p class="small text-muted mb-0">
                Lesson content is written in Markdown; headings, emphasis, lists, fences, links, etc. render below.
            </p>
        </header>
        @if (!Model.Lesson.Published && User.IsInRole("Admin"))
        {
            <div class="alert alert-secondary">Draft preview (admins-only until you publish).</div>
        }

        <div class="lesson-markdown lesson-body border rounded bg-body-secondary p-4 mb-4">
            @Html.Raw(Model.LessonHtml)
        </div>

        @if (Model.QuestionCount > 0)
        {
            <div class="card border-primary-subtle shadow-sm mb-4">
                <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">Check your understanding</h2>
                        <p class="text-muted small mb-0">
                            @Model.QuestionCount quick question@(Model.QuestionCount == 1 ? "" : "s") on this lesson.
                            @if (Model.BestQuizPercent is int best)
                            {
                                <span>Your best score so far: <strong class="text-body">@best%</strong>.</span>
                            }
                        </p>
                    </div>
                    <a class="btn btn-primary" asp-page="Quiz" asp-route-slug="@Model.Lesson.Slug">
                        @(Model.BestQuizPercent is null ? "Take the quiz" : "Retake the quiz")
                    </a>
                </div>
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <section class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
                <div>
                    @if (Model.IsCompleted)
                    {
                        <span class="badge text-bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light text-muted border">In progress</span>
                    }
                </div>
                @if (!Model.IsCompleted)
                {
                    <form method="post" asp-page-handler="Complete" class="mb-0">
                        <input type="hidden" name="slug" value="@Model.Lesson.Slug" />
                        <button type="submit" class="btn btn-primary">Mark as complete</button>
                    </form>
                }
            </section>
        }
        else
        {
            <p class="text-muted mb-0">
                <a asp-area="Identity" asp-page="/Account/Register">Create a free account</a>
                or
                <a asp-area="Identity" asp-page="/Account/Login">log in</a>
                to track completion.
            </p>
        }

        @if (Model.PreviousLesson is not null || Model.NextLesson is not null)
        {
            <nav class="d-flex justify-content-between gap-3 border-top pt-4 mt-4" aria-label="Lesson navigation">
                <div>
                    @if (Model.PreviousLesson is { } prev)
                    {
                        <a class="text-decoration-none" asp-page="Detail" asp-route-slug="@prev.Slug">
                            <div class="small text-muted">&larr; Previous</div>
                            <div class="fw-semibold">@prev.Title</div>
                        </a>
                    }
                </div>
                <div class="text-end">
                    @if (Model.NextLesson is { } next)
                    {
                        <a class="text-decoration-none" asp-page="Detail" asp-route-slug="@next.Slug">
                            <div class="small text-muted">Next &rarr;</div>
                            <div class="fw-semibold">@next.Title</div>
                        </a>
                    }
                </div>
            </nav>
        }
    </article>
}

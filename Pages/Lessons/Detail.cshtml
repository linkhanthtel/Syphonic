@page "/Lessons/{slug}"
@model DetailModel
@{
    ViewData["Title"] = Model.Lesson?.Title ?? "Lesson";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (Model.Lesson is null)
{
    <div class="alert alert-warning mb-0">Lesson not found.</div>
}
else
{
    <div class="sy-pagebar">
        <partial name="_Breadcrumbs" model="@(new Crumb[] { new("Lessons", Url.Page("/Lessons/Index")), new(Model.Lesson.Title) })" />
        @if (Model.Course.Count > 1)
        {
            @* Jump to any lesson without going back to the list. *@
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Lesson @Model.Position of @Model.Course.Count
                </button>
                <ul class="dropdown-menu dropdown-menu-end sy-course-menu">
                    <li><h6 class="dropdown-header">Jump to a lesson</h6></li>
                    @for (var i = 0; i < Model.Course.Count; i++)
                    {
                        var item = Model.Course[i];
                        <li>
                            <a class="dropdown-item d-flex justify-content-between gap-3 @(item.IsCurrent ? "active" : null)"
                               aria-current="@(item.IsCurrent ? "page" : null)"
                               asp-page="Detail" asp-route-slug="@item.Slug">
                                <span>@(i + 1). @item.Title</span>
                                @if (item.IsCompleted)
                                {
                                    <span class="small @(item.IsCurrent ? null : "text-success") fw-semibold">Done</span>
                                }
                            </a>
                        </li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-page="Index">See all lessons</a></li>
                </ul>
            </div>
        }
    </div>

    <article class="mt-3">
        <header class="mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h1 class="mb-2">@Model.Lesson.Title</h1>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page-handler="Bookmark" class="flex-shrink-0">
                        <input type="hidden" name="slug" value="@Model.Lesson.Slug" />
                        <button type="submit" class="btn btn-sm @(Model.IsBookmarked ? "btn-warning" : "btn-outline-secondary")"
                                aria-pressed="@(Model.IsBookmarked ? "true" : "false")">
                            @(Model.IsBookmarked ? "Saved" : "Save for later")
                        </button>
                    </form>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Lesson.Summary))
            {
                <p class="lead text-muted mb-1">@Model.Lesson.Summary</p>
            }
            <p class="small text-muted mb-0">
                About @Model.ReadingMinutes min read
                @if (Model.QuestionCount > 0)
                {
                    <span>· @Model.QuestionCount-question quiz at the end</span>
                }
            </p>
        </header>
        @if (!Model.Lesson.Published && User.IsInRole("Admin"))
        {
            <div class="alert alert-secondary">Draft preview (admins-only until you publish).</div>
        }

        @* A thin bar under the navbar that fills as the learner scrolls through the lesson text. *@
        <div class="sy-read-progress" aria-hidden="true"><div data-read-progress></div></div>

        @if (Model.Outline.Count >= 2)
        {
            <nav class="card shadow-sm mb-4" aria-labelledby="outline-heading">
                <div class="card-body">
                    <h2 id="outline-heading" class="h6">On this page</h2>
                    <ol class="sy-outline mb-0">
                        @foreach (var heading in Model.Outline)
                        {
                            <li class="@(heading.Level == 3 ? "sy-outline-sub" : null)"><a href="#@heading.Id">@heading.Text</a></li>
                        }
                    </ol>
                </div>
            </nav>
        }

        <div class="lesson-markdown lesson-body border rounded bg-body-secondary p-4 mb-4" data-lesson-body>
            @Html.Raw(Model.LessonHtml)
        </div>

        @if (Model.QuestionCount > 0)
        {
            <div class="card border-primary-subtle shadow-sm mb-4">
                <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">Check your understanding</h2>
                        <p class="text-muted small mb-0">
                            @Model.QuestionCount quick question@(Model.QuestionCount == 1 ? "" : "s") on this lesson. Recalling the answers is what makes them stick.
                            @if (Model.BestQuizPercent is int best)
                            {
                                <span>Your best score so far: <strong class="text-body">@best%</strong>.</span>
                            }
                        </p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                        <a class="btn btn-outline-primary" asp-page="/Practice/Flashcards" asp-route-lesson="@Model.Lesson.Slug">Flashcards</a>
                        <a class="btn btn-primary" asp-page="Quiz" asp-route-slug="@Model.Lesson.Slug">
                            @(Model.BestQuizPercent is null ? "Take the quiz" : "Retake the quiz")
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <section class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
                <div>
                    @if (Model.IsCompleted)
                    {
                        <span class="badge text-bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light text-muted border">In progress</span>
                    }
                </div>
                @if (!Model.IsCompleted)
                {
                    <form method="post" asp-page-handler="Complete" class="mb-0">
                        <input type="hidden" name="slug" value="@Model.Lesson.Slug" />
                        <button type="submit" class="btn @(Model.QuestionCount > 0 ? "btn-outline-primary" : "btn-primary")">Mark as complete</button>
                    </form>
                }
                else if (Model.NextLesson is { } upNext)
                {
                    <a class="btn btn-primary" asp-page="Detail" asp-route-slug="@upNext.Slug">Next lesson: @upNext.Title</a>
                }
            </section>
        }
        else
        {
            <p class="text-muted mb-0">
                <a asp-area="Identity" asp-page="/Account/Register">Create a free account</a>
                or
                <a asp-area="Identity" asp-page="/Account/Login">log in</a>
                to track completion.
            </p>
        }

        @if (Model.PreviousLesson is not null || Model.NextLesson is not null)
        {
            <nav class="d-flex justify-content-between gap-3 border-top pt-4 mt-4" aria-label="Previous and next lesson">
                <div>
                    @if (Model.PreviousLesson is { } prev)
                    {
                        <a class="text-decoration-none" asp-page="Detail" asp-route-slug="@prev.Slug">
                            <div class="small text-muted">Previous lesson</div>
                            <div class="fw-semibold">@prev.Title</div>
                        </a>
                    }
                </div>
                <div class="text-end">
                    @if (Model.NextLesson is { } next)
                    {
                        <a class="text-decoration-none" asp-page="Detail" asp-route-slug="@next.Slug">
                            <div class="small text-muted">Next lesson</div>
                            <div class="fw-semibold">@next.Title</div>
                        </a>
                    }
                </div>
            </nav>
        }

        <partial name="_WhereNext" model="@(Model.QuestionCount > 0 ? new Crumb("Flashcards for this lesson", Url.Page("/Practice/Flashcards", new { lesson = Model.Lesson.Slug })) : null)" />
    </article>
}

@section Scripts {
    <script src="~/js/lesson.js" asp-append-version="true"></script>
}

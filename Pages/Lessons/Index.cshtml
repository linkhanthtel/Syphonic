@page
@model IndexModel
@{
    ViewData["Title"] = "Lessons";
}
<h1 class="mb-3">Lesson library</h1>
<p class="lead text-muted mb-4">Pick a lesson to read deeply. Signed-in learners can mark lessons complete.</p>

@if (!Model.Lessons.Any())
{
    <div class="alert alert-info mb-0">No lessons published yet.</div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var lesson in Model.Lessons)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start"
               asp-page="Detail" asp-route-slug="@lesson.Slug">
                <div class="me-3">
                    <div class="fw-semibold">@lesson.Title</div>
                    @if (!string.IsNullOrWhiteSpace(lesson.Summary))
                    {
                        <div class="text-muted small mb-1">@lesson.Summary</div>
                    }
                </div>
                <span class="badge rounded-pill text-bg-secondary align-self-center">
                    Lesson
                </span>
            </a>
        }
    </div>
}

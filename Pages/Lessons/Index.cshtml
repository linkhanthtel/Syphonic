@page
@model IndexModel
@using Syphonic.Services
@{
    ViewData["Title"] = "Lessons";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="mb-1">Lessons</h1>
        <p class="text-muted mb-0">Read a lesson, then practise it with its quiz. Score @QuizResult.PassPercent% or more to pass.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Practice/Index">Mixed practice round</a>
</div>

@* ---------- Course progress (signed-in) or a sign-up nudge (guests) ---------- *@
@if (Model.IsSignedIn && Model.TotalLessons > 0)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-semibold">Course progress</span>
                    <span>@Model.CompletedLessons of @Model.TotalLessons completed</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Course progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.CompletionPercent" style="height: .6rem">
                    <div class="progress-bar sy-bar-fill" style="width: @Model.CompletionPercent%"></div>
                </div>
            </div>
            @if (Model.ContinueLesson is { } next)
            {
                <a class="btn btn-primary flex-shrink-0" asp-page="Detail" asp-route-slug="@next.Slug">
                    @(next.HasProgress ? "Continue" : "Start"): @next.Title
                </a>
            }
            else
            {
                <span class="badge text-bg-success fs-6 flex-shrink-0">Course complete</span>
            }
        </div>
    </div>
}
else if (!Model.IsSignedIn)
{
    <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <span>Every lesson and quiz is free to use. Sign in to save your progress and quiz scores.</span>
        <span>
            <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Register">Create account</a>
            <a class="btn btn-sm btn-link" asp-area="Identity" asp-page="/Account/Login">Log in</a>
        </span>
    </div>
}

@* ---------- Search + status filter ---------- *@
<div class="d-flex flex-column flex-lg-row gap-3 justify-content-between mb-3">
    <ul class="nav nav-pills flex-nowrap overflow-auto sy-filter" aria-label="Filter lessons">
        @foreach (var tab in Model.Filters)
        {
            <li class="nav-item">
                <a class="nav-link text-nowrap @(tab.IsActive ? "active" : null)" aria-current="@(tab.IsActive ? "true" : null)"
                   asp-page="Index" asp-route-show="@(tab.Key == "all" ? null : tab.Key)" asp-route-q="@Model.Query">
                    @tab.Label <span class="badge rounded-pill @(tab.IsActive ? "text-bg-light" : "text-bg-secondary")">@tab.Count</span>
                </a>
            </li>
        }
    </ul>
    <form method="get" role="search" class="sy-lesson-search">
        @if (Model.Show != "all")
        {
            <input type="hidden" name="show" value="@Model.Show" />
        }
        <div class="input-group">
            <input type="search" name="q" value="@Model.Query" class="form-control"
                   placeholder="Search, e.g. ocean, capitals" aria-label="Search lessons" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @if (Model.IsSearching)
            {
                <a class="btn btn-outline-secondary" asp-page="Index" asp-route-show="@(Model.Show == "all" ? null : Model.Show)">Clear</a>
            }
        </div>
    </form>
</div>

@if (Model.IsSearching)
{
    <p class="small text-muted">
        @Model.Lessons.Count result@(Model.Lessons.Count == 1 ? "" : "s") for “@Model.Query”
    </p>
}

@if (!Model.Lessons.Any())
{
    <div class="alert alert-info mb-0">
        @if (Model.TotalLessons == 0)
        {
            <span>No lessons published yet.</span>
        }
        else
        {
            <span>No lessons match. <a asp-page="Index">Show all lessons</a>.</span>
        }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var lesson in Model.Lessons)
        {
            var inProgress = lesson.HasProgress && !lesson.IsCompleted;
            <div class="col-md-6 col-xl-4">
                <article class="card sy-lesson-card h-100 shadow-sm @(lesson.IsCompleted ? "sy-lesson-done" : null)">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="sy-lesson-number" aria-hidden="true">@lesson.Number</span>
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                @if (!lesson.Published)
                                {
                                    <span class="badge text-bg-secondary">Draft</span>
                                }
                                @if (lesson.IsBookmarked)
                                {
                                    <span class="badge text-bg-light border">Saved</span>
                                }
                                @if (lesson.IsCompleted)
                                {
                                    <span class="badge text-bg-success">Completed</span>
                                }
                                else if (inProgress)
                                {
                                    <span class="badge text-bg-warning">In progress</span>
                                }
                                else if (Model.IsSignedIn)
                                {
                                    <span class="badge text-bg-light border">New</span>
                                }
                            </div>
                        </div>
                        <h2 class="h5 mb-1">
                            <a class="text-decoration-none text-body" asp-page="Detail" asp-route-slug="@lesson.Slug">@lesson.Title</a>
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(lesson.Summary))
                        {
                            <p class="small text-muted mb-3">@lesson.Summary</p>
                        }

                        <div class="mt-auto">
                            @if (lesson.BestQuizPercent is int best)
                            {
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Best quiz score</span>
                                    <strong>@best% @(best >= QuizResult.PassPercent ? "· passed" : "")</strong>
                                </div>
                                <div class="sy-meter mb-3" role="progressbar" aria-label="Best quiz score for @lesson.Title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@best">
                                    <div class="sy-meter-fill" style="width: @best%"></div>
                                    <div class="sy-meter-mark" style="left: @QuizResult.PassPercent%" title="Pass mark @QuizResult.PassPercent%"></div>
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm @(lesson.IsCompleted ? "btn-outline-secondary" : "btn-primary")" asp-page="Detail" asp-route-slug="@lesson.Slug">
                                    @(lesson.IsCompleted ? "Review lesson" : inProgress ? "Continue reading" : "Read lesson")
                                </a>
                                @if (lesson.QuestionCount > 0)
                                {
                                    <a class="btn btn-sm @(lesson.IsCompleted ? "btn-primary" : "btn-outline-primary")" asp-page="Quiz" asp-route-slug="@lesson.Slug"
                                       aria-label="@(lesson.BestQuizPercent is null ? "Practice quiz" : "Retake quiz") for @lesson.Title, @lesson.QuestionCount questions">
                                        @(lesson.BestQuizPercent is null ? "Practice quiz" : "Retake quiz") · @lesson.QuestionCount
                                    </a>
                                }
                                else
                                {
                                    <span class="small text-muted align-self-center">No quiz yet</span>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

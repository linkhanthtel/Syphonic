@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
}
<h1 class="mb-3">Profile overview</h1>
<p class="lead text-muted mb-4">
    Lightweight snapshot of how your account participates in geography practice.
</p>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Basics</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small text-uppercase">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4 text-muted small text-uppercase">Display name</dt>
                    <dd class="col-sm-8">@(Model.DisplayName ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small text-uppercase">Member since</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("D")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">Account tools</h2>
                <p class="small text-muted">Use the built-in Identity management pages to change password, email, or sign-in methods.</p>
                <a class="btn btn-outline-primary w-100 mb-2" asp-area="Identity" asp-page="/Account/Manage/Index">Manage account</a>
                <a class="btn btn-outline-secondary w-100" asp-page="/Dashboard/Index">Back to dashboard</a>
            </div>
        </div>
    </div>
</div>

@page
@model CreateModel
@{
    ViewData["Title"] = "Create lesson";
}

<h1 class="mb-3">Create geography lesson</h1>
@if (!ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>
}

<form method="post" class="needs-validation">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.SlugOverride" class="form-label"></label>
                <input asp-for="Input.SlugOverride" class="form-control" placeholder="auto-generated when empty" />
                <div class="form-text">Letters, digits, hyphen only; leave blank and we'll slugify from the title.</div>
                <span asp-validation-for="Input.SlugOverride" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Summary" class="form-label"></label>
                <textarea asp-for="Input.Summary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Summary" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Content" class="form-label"></label>
                <textarea asp-for="Input.Content" class="form-control" rows="14"></textarea>
                <div class="form-text">Rendered as monospace text for now; plug in Markdown or rich text editors later.</div>
                <span asp-validation-for="Input.Content" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.OrderIndex" class="form-label"></label>
                    <input asp-for="Input.OrderIndex" class="form-control" />
                    <span asp-validation-for="Input.OrderIndex" class="text-danger small"></span>
                </div>
                <div class="col-md-4 d-flex align-items-end pb-3">
                    <div class="form-check">
                        <input asp-for="Input.Published" class="form-check-input" />
                        <label asp-for="Input.Published" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save lesson</button>
        <a class="btn btn-outline-secondary" asp-page="/Lessons/Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}

@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = $"Edit lesson";
}

<h1 class="mb-3">Edit lesson</h1>
@if (!ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>
}

<form method="post" class="needs-validation">
    <input type="hidden" asp-for="Input.Id"/>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Slug" class="form-label"></label>
                <input asp-for="Input.Slug" class="form-control" />
                <div class="form-text text-muted small">Slug appears in learner URLs (/Lessons/[slug]).</div>
                <span asp-validation-for="Input.Slug" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Summary" class="form-label"></label>
                <textarea asp-for="Input.Summary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Summary" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Content" class="form-label"></label>
                <textarea asp-for="Input.Content" class="form-control" rows="14"></textarea>
                <span asp-validation-for="Input.Content" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.OrderIndex" class="form-label"></label>
                    <input asp-for="Input.OrderIndex" class="form-control" />
                    <span asp-validation-for="Input.OrderIndex" class="text-danger small"></span>
                </div>
                <div class="col-md-4 d-flex align-items-end pb-3">
                    <div class="form-check">
                        <input asp-for="Input.Published" class="form-check-input"/>
                        <label asp-for="Input.Published" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-5">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-secondary" asp-page="/Lessons/Index">Back to catalog</a>
        <a class="btn btn-link" asp-area="" asp-page="/Lessons/Detail" asp-route-slug="@Model.Input.Slug">
            Preview learner view
        </a>
    </div>
</form>

<form method="post" asp-page-handler="Delete">
    @Html.Hidden("id", Model.Input.Id)
    <button type="submit"
            class="btn btn-outline-danger"
            onclick="return confirm('Delete permanently? learner progress cascades.');">
        Delete lesson permanently
    </button>
</form>

@section Scripts {
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
